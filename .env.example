DATABASE_URL=postgresql+asyncpg://remediator:remediator@localhost:5432/remediator
# Placeholders below are accepted in fake mode only; live mode refuses `change-me` and any
# value shorter than 16 characters for both secrets.
GITHUB_WEBHOOK_SECRET=change-me
OPERATOR_TOKEN=change-me
# FAKE-MODE VALUE: the Phase 1-5 simulation fixtures are keyed to apache/superset. The
# controlled canary allowlists exactly one fork, see "Controlled live canary" at the bottom.
GITHUB_REPOSITORY=apache/superset
# Branch whose tip becomes the exact base SHA pinned in every triage session (live mode only).
# The pipeline always resolves the CURRENT tip; no SHA is ever configured for execution.
GITHUB_BASE_REF=master
# Optional, readiness-only: the last base SHA a human verified probes/tooling against.
# `make readiness` resolves the live tip of GITHUB_BASE_REF and warns when it moved on.
# GITHUB_BASE_SHA_REFERENCE=
GITHUB_API_BASE_URL=https://api.github.com
# fake: in-memory issues/labels/comments store (default). live: real GitHub REST API.
GITHUB_CLIENT_MODE=fake
# Fine-grained PAT scoped to the Superset fork only: Issues read/write + Metadata read.
# Also used (read-only) by the commits API that pins the triage base SHA. Never commit a
# real value; it is never logged or persisted. Production should prefer a GitHub App with
# short-lived installation tokens (see docs/architecture.md).
# GITHUB_TOKEN=
# Label whose signed `labeled` webhook is the only path into REMEDIATION_APPROVED.
GITHUB_REMEDIATION_LABEL=devin:remediate
# Fake-mode only: make every label write fail to exercise APPROVAL_DELIVERY_FAILED + retry.
GITHUB_FAKE_FAIL_LABELS=false
GITHUB_ALLOWED_EVENTS=issues
GITHUB_ALLOWED_ACTIONS=opened,labeled
# Empty (default): every opened issue is evaluated by the zero-ACU eligibility filter.
# Set e.g. devin:triage to make intake opt-in; mandatory (readiness fails otherwise) once
# Devin is live, and it must differ from GITHUB_REMEDIATION_LABEL.
GITHUB_REQUIRED_LABEL=
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=300
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
EVENT_MAX_ATTEMPTS=3
RECONCILE_RETRY_DELAY_SECONDS=1.0
RECONCILE_MAX_ATTEMPTS=3

# --- Devin -------------------------------------------------------------------
# fake: deterministic in-memory client, zero ACU spend (default).
# live: real Devin v3 API; requires DEVIN_API_KEY and DEVIN_ORG_ID or the process refuses to start.
DEVIN_CLIENT_MODE=fake
# Service-user API key. Never commit a real value; it is never logged or persisted.
# DEVIN_API_KEY=
# Organization id, e.g. org-abc123def456
# DEVIN_ORG_ID=
DEVIN_API_BASE_URL=https://api.devin.ai/v3
# Hard ACU ceiling passed as max_acu_limit on every triage session.
DEVIN_TRIAGE_MAX_ACU=5
# Absolute wall-clock budget per triage session. On expiry the session is re-read once,
# then terminated remotely; the case only becomes TIMED_OUT after termination is confirmed.
# FAKE-MODE VALUE: keeps the simulation fast. Live mode refuses anything below 300s
# (recommended 1800) so a copied example can never kill a real session after 3 seconds.
DEVIN_TRIAGE_TIMEOUT_SECONDS=3
# Delay between GET /sessions/{id} polls. Live mode enforces >= 10s (recommended 10-30s).
# The fake value below keeps the simulation fast.
DEVIN_POLL_INTERVAL_SECONDS=0.05
# Format string for the single entry sent in `repos[]` on POST /sessions. Default: the
# owner/repo repository path, the identifier every other v3 repository surface uses
# (repository listing `repo_path`, the `repo_names` session filter). Must contain
# `{repository}` exactly once; `https://github.com/{repository}` remains accepted for
# operators who verified the URL form themselves. `make readiness` reports the value and,
# with live Devin, checks the organization's repository listing for the allowlisted path.
DEVIN_REPOS_FORMAT={repository}

MAX_ATTEMPTS_PER_KIND=3

# --- Remediation (Phase 4) ------------------------------------------------------
# Hard ACU ceiling passed as max_acu_limit on every remediation session.
DEVIN_REMEDIATION_MAX_ACU=15
# Wall-clock budget per remediation session; same final-GET-then-DELETE semantics as triage.
# FAKE-MODE VALUE (live mode enforces >= 600s; recommended 5400).
DEVIN_REMEDIATION_TIMEOUT_SECONDS=30
# Devin must push its branch under this prefix; GitHub PR validation enforces it.
DEVIN_REMEDIATION_BRANCH_PREFIX=devin/
# fake: deterministic runner keyed by fixture issue number, zero external execution (default).
# remote: delegate to the verifier front (`verifier` service in docker-compose.yml), which
# forwards to the credential-free `verifier-runner` over an internal-only network; the runner
# reaches the internet solely via `egress-proxy` (CONNECT :443 to EGRESS_ALLOWED_HOSTS). The
# worker holds credentials and therefore never executes repository code itself; there is no
# "local" mode for the worker. Live Devin mode requires remote.
PROBE_RUNNER_MODE=fake
# Verifier front URL (required with PROBE_RUNNER_MODE=remote). Before every probe the worker
# checks the signed GET /capabilities and refuses a verifier that executes in-process
# (`execution` != runner), can see any credential, runs as root, has a writable root
# filesystem, has direct internet egress or lacks a tool the probe manifest requires.
PROBE_VERIFIER_URL=http://verifier:8080
# Phase 5: HMAC key shared with the verifier FRONT only (>= 32 chars). Generate with
# `openssl rand -hex 32`, write it to docker/secrets/verifier_hmac_key (git-ignored; mounted
# as a Docker secret into `verifier`, never into `verifier-runner`) and set the identical
# value here for the worker. It is the ONLY value that crosses the credential boundary; it
# grants nothing but the right to ask the verifier to run an already-registered probe.
# Required with PROBE_RUNNER_MODE=remote.
# PROBE_VERIFIER_SHARED_SECRET=
PROBE_VERIFIER_REQUEST_TIMEOUT_SECONDS=30
# Refuse a verifier whose /capabilities cannot show no-new-privileges, empty capability
# sets and cgroup PID/memory limits (i.e. compose hardening is not in effect). Live mode
# forces this on; only ever `false` for in-process tests.
PROBE_VERIFIER_REQUIRE_ISOLATION=true
# Immutable probe registry root: probes/<owner>/<repo>/<issue-number>/{probe.yaml,probe.sh}
PROBE_ROOT=probes
PROBE_TIMEOUT_SECONDS=900
PROBE_MAX_OUTPUT_BYTES=65536
# Reserved registry slot (issue 0 = never a case) run by `readiness --verifier-smoke`: the
# real Superset Jest test at a pinned SHA, through the runner and the egress proxy.
PROBE_SMOKE_PROBE=apache/superset#0
# The verifier services are configured in docker-compose.yml and must NOT read this file:
# VERIFIER_EXECUTION, VERIFIER_RUNNER_URL, VERIFIER_CLONE_URL_FORMAT,
# VERIFIER_MAX_TIMEOUT_SECONDS, VERIFIER_MAX_CONCURRENT (must stay 1), VERIFIER_MAX_PROCESSES,
# VERIFIER_MAX_FILE_SIZE_BYTES, VERIFIER_MAX_MEMORY_BYTES, VERIFIER_EGRESS_PROXY_URL,
# VERIFIER_EGRESS_CHECK. Only these two are read by compose from the shell/.env for
# substitution into the proxy/runner definitions:
# EGRESS_ALLOWED_HOSTS=github.com,codeload.github.com,objects.githubusercontent.com,registry.npmjs.org,registry.yarnpkg.com,cdn.sheetjs.com
# VERIFIER_REPOSITORY_ALLOWLIST=apache/superset
# GitHub check-run polling for the verified head SHA. FAKE-MODE VALUES keep the simulation
# fast; live mode enforces CI_POLL_INTERVAL_SECONDS >= 30.
CI_POLL_INTERVAL_SECONDS=0.5
CI_TIMEOUT_SECONDS=20
# Comma-separated GitHub logins accepted as the PR author (the Devin GitHub App identity).
GITHUB_PR_AUTHOR_LOGINS=devin-ai-integration[bot]
# Comma-separated check-run names that must succeed before CI_PASSED. Empty: every observed
# check must succeed and at least one must exist (absent checks never pass).
GITHUB_REQUIRED_CHECKS=
# PRs changing more files than this become REMEDIATION_HUMAN_BLOCKED (scope expansion).
REMEDIATION_MAX_CHANGED_FILES=25

# --- Concurrency and spend controls (Phase 5) ---------------------------------------
# Database-backed leases (capacity_leases) shared by every worker; survive restarts.
# A case that finds a limit full is parked (cases.waiting_for set, zero ACUs) and re-checked after the backoff.
# FAKE-MODE VALUE: the capacity simulation needs 2; the canary runs every limit at 1.
MAX_CONCURRENT_TRIAGE=2
MAX_CONCURRENT_REMEDIATION=1
MAX_CONCURRENT_PROBES=1
MAX_CONCURRENT_REMEDIATION_PER_REPOSITORY=1
# How long a parked case waits before re-checking capacity.
CAPACITY_WAIT_BACKOFF_SECONDS=5
# A lease not heartbeaten for this long (crashed worker) is reclaimed by any worker.
CAPACITY_LEASE_GRACE_SECONDS=600

# --- Request hardening (Phase 5) ------------------------------------------------------
# Any request body larger than this is rejected with 413 before parsing.
MAX_REQUEST_BODY_BYTES=1048576
# Token bucket for authenticated operator mutations (retry/cancel/...), per client.
OPERATOR_RATE_LIMIT_PER_MINUTE=60
# Extra Origins accepted for cookie-authenticated mutations (DASHBOARD_BASE_URL and
# PUBLIC_BASE_URL are always trusted). Comma-separated.
OPERATOR_CSRF_TRUSTED_ORIGINS=
# Externally reachable base URL of this API (webhook/tunnel); checked by `make readiness`.
PUBLIC_BASE_URL=

# --- ACU reporting (Phase 5, optional) ---------------------------------------------
# Read per-session ACU usage from the official consumption endpoint after a session ends.
# Needs an organization plan and service-user permission that expose that endpoint; on
# 401/403/404 or an unsupported plan the dashboard shows `Unavailable`. Never estimated;
# failures never affect remediation.
DEVIN_ACU_REPORTING_ENABLED=false

# --- Metrics (Phase 5) ------------------------------------------------------------
# GET /metrics (operator token) labels every series with mode="live" only when Devin,
# GitHub and Slack are all live; anything else is mode="simulated". Two scrape targets:
# the API serves the request-edge counters and the database-derived gauges; the worker
# serves its own process counters/histograms (probes, sessions, provider calls, capacity
# denials, retries) on this port. 0 disables the worker endpoint.
WORKER_METRICS_PORT=8001

# --- Slack approval (Phase 3) -------------------------------------------------
# fake: messages are stored in PostgreSQL (slack_fake_messages) and readable from the
#       operator-only endpoint GET /api/slack/fake/messages (default).
# live: real Slack Web API (chat.postMessage / chat.update). Requires SLACK_BOT_TOKEN,
#       SLACK_SIGNING_SECRET, SLACK_CHANNEL_ID and SLACK_APPROVER_USER_IDS or the process
#       refuses to start.
SLACK_CLIENT_MODE=fake
# Bot token (xoxb-...) with chat:write plus channels:history (public channel) or
# groups:history (private channel); the history scope is needed to reconcile a post whose
# commit was lost instead of duplicating it. Never commit a real value; never logged or persisted.
# SLACK_BOT_TOKEN=
# App signing secret used to verify POST /webhooks/slack/actions (v0:{ts}:{body} HMAC-SHA256).
# The placeholder is accepted in fake mode only (the simulator signs with it); live mode
# refuses `change-me` and anything shorter than 16 characters. Blank disables the endpoint.
SLACK_SIGNING_SECRET=change-me-slack-signing
# Channel that receives approval requests.
SLACK_CHANNEL_ID=C0000000000
# Comma-separated Slack user ids allowed to approve/reject. Everyone else is refused.
SLACK_APPROVER_USER_IDS=U0000000001
# Replay window for X-Slack-Request-Timestamp.
SLACK_MAX_TIMESTAMP_SKEW_SECONDS=300
# Lifetime of the opaque action token embedded in the Slack buttons.
SLACK_ACTION_TOKEN_TTL_SECONDS=604800
SLACK_API_BASE_URL=https://slack.com/api
# Fake-mode only: make chat.postMessage fail to exercise notification failure + retry.
SLACK_FAKE_FAIL_POSTS=false
# Public base URL used for "View evidence/dashboard" links in Slack and GitHub comments.
DASHBOARD_BASE_URL=http://localhost:8000

# --- Transactional outbox -----------------------------------------------------
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF_SECONDS=2
OUTBOX_MAX_BACKOFF_SECONDS=300
OUTBOX_LEASE_SECONDS=120
LOG_LEVEL=INFO
# Secure flag on the operator dashboard cookie. Readiness fails and LIVE_CANARY refuses to
# start with `false` once any provider is live: the dashboard must sit behind HTTPS.
COOKIE_SECURE=false

# --- Controlled live canary (Phase 6) -------------------------------------------------
# Opt-in fail-closed envelope for the first live end-to-end run. With `true` the process
# refuses to start unless: exactly one repository is allowlisted, GITHUB_REQUIRED_LABEL is
# set and differs from the remediation label, every MAX_CONCURRENT_* limit is 1,
# PROBE_RUNNER_MODE=remote, COOKIE_SECURE=true whenever GitHub or Slack is live, and GitHub
# plus Slack are live whenever Devin is. Turn it on before step 3 of docs/canary-runbook.md
# and keep it on for the whole canary. The overrides below are the canary values; copy them
# into the deployment's .env (never into this file) together with the real secrets.
LIVE_CANARY=false
# GITHUB_REPOSITORY=marcelaubry/superset
# GITHUB_BASE_REF=master
# GITHUB_REQUIRED_LABEL=devin:triage
# GITHUB_REMEDIATION_LABEL=devin:remediate
# GITHUB_ALLOWED_ACTIONS=opened,labeled
# MAX_CONCURRENT_TRIAGE=1
# MAX_CONCURRENT_REMEDIATION=1
# MAX_CONCURRENT_PROBES=1
# MAX_CONCURRENT_REMEDIATION_PER_REPOSITORY=1
# PROBE_RUNNER_MODE=remote
# VERIFIER_REPOSITORY_ALLOWLIST=marcelaubry/superset
# PROBE_SMOKE_PROBE=marcelaubry/superset#0
# COOKIE_SECURE=true
# PUBLIC_BASE_URL=https://<public-webhook-host>
# DASHBOARD_BASE_URL=https://<public-webhook-host>
# DEVIN_TRIAGE_TIMEOUT_SECONDS=1800
# DEVIN_REMEDIATION_TIMEOUT_SECONDS=5400
# DEVIN_POLL_INTERVAL_SECONDS=15
# CI_POLL_INTERVAL_SECONDS=60
# CI_TIMEOUT_SECONDS=7200
