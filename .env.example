DATABASE_URL=postgresql+asyncpg://remediator:remediator@localhost:5432/remediator
# Placeholders below are accepted in fake mode only; live mode refuses `change-me` and any
# value shorter than 16 characters for both secrets.
GITHUB_WEBHOOK_SECRET=change-me
OPERATOR_TOKEN=change-me
GITHUB_REPOSITORY=apache/superset
# Branch whose tip becomes the exact base SHA pinned in every triage session (live mode only).
GITHUB_BASE_REF=master
GITHUB_API_BASE_URL=https://api.github.com
# fake: in-memory issues/labels/comments store (default). live: real GitHub REST API.
GITHUB_CLIENT_MODE=fake
# Fine-grained PAT scoped to the Superset fork only: Issues read/write + Metadata read.
# Also used (read-only) by the commits API that pins the triage base SHA. Never commit a
# real value; it is never logged or persisted. Production should prefer a GitHub App with
# short-lived installation tokens (see docs/architecture.md).
# GITHUB_TOKEN=
# Label whose signed `labeled` webhook is the only path into REMEDIATION_APPROVED.
GITHUB_REMEDIATION_LABEL=devin:remediate
# Fake-mode only: make every label write fail to exercise APPROVAL_DELIVERY_FAILED + retry.
GITHUB_FAKE_FAIL_LABELS=false
GITHUB_ALLOWED_EVENTS=issues
GITHUB_ALLOWED_ACTIONS=opened,labeled
GITHUB_REQUIRED_LABEL=devin-candidate
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=300
WORKER_SHUTDOWN_TIMEOUT_SECONDS=30
EVENT_MAX_ATTEMPTS=3
RECONCILE_RETRY_DELAY_SECONDS=1.0
RECONCILE_MAX_ATTEMPTS=3

# --- Devin -------------------------------------------------------------------
# fake: deterministic in-memory client, zero ACU spend (default).
# live: real Devin v3 API; requires DEVIN_API_KEY and DEVIN_ORG_ID or the process refuses to start.
DEVIN_CLIENT_MODE=fake
# Service-user API key. Never commit a real value; it is never logged or persisted.
# DEVIN_API_KEY=
# Organization id, e.g. org-abc123def456
# DEVIN_ORG_ID=
DEVIN_API_BASE_URL=https://api.devin.ai/v3
# Hard ACU ceiling passed as max_acu_limit on every triage session.
DEVIN_TRIAGE_MAX_ACU=5
# Absolute wall-clock budget per triage session. On expiry the session is re-read once,
# then terminated remotely; the case only becomes TIMED_OUT after termination is confirmed.
# FAKE-MODE VALUE: keeps the simulation fast. Live mode refuses anything below 300s
# (recommended 1800) so a copied example can never kill a real session after 3 seconds.
DEVIN_TRIAGE_TIMEOUT_SECONDS=3
# Delay between GET /sessions/{id} polls. Live mode enforces >= 10s (recommended 10-30s).
# The fake value below keeps the simulation fast.
DEVIN_POLL_INTERVAL_SECONDS=0.05
# Format string for the single allowlisted entry sent in `repos`. UNVERIFIED against the live
# API: the v3 OpenAPI declares `repos` as array[string] without a documented entry format.
# Before enabling live mode, confirm the accepted value with one minimal session (or Devin
# support) and switch to `{repository}` (owner/repo) if the URL form is rejected.
DEVIN_REPOS_FORMAT=https://github.com/{repository}

MAX_ATTEMPTS_PER_KIND=3

# --- Slack approval (Phase 3) -------------------------------------------------
# fake: messages are stored in PostgreSQL (slack_fake_messages) and readable from the
#       operator-only endpoint GET /api/slack/fake/messages (default).
# live: real Slack Web API (chat.postMessage / chat.update). Requires SLACK_BOT_TOKEN,
#       SLACK_SIGNING_SECRET, SLACK_CHANNEL_ID and SLACK_APPROVER_USER_IDS or the process
#       refuses to start.
SLACK_CLIENT_MODE=fake
# Bot token (xoxb-...) with chat:write plus channels:history (public channel) or
# groups:history (private channel); the history scope is needed to reconcile a post whose
# commit was lost instead of duplicating it. Never commit a real value; never logged or persisted.
# SLACK_BOT_TOKEN=
# App signing secret used to verify POST /webhooks/slack/actions (v0:{ts}:{body} HMAC-SHA256).
# The placeholder is accepted in fake mode only (the simulator signs with it); live mode
# refuses `change-me` and anything shorter than 16 characters. Blank disables the endpoint.
SLACK_SIGNING_SECRET=change-me-slack-signing
# Channel that receives approval requests.
SLACK_CHANNEL_ID=C0000000000
# Comma-separated Slack user ids allowed to approve/reject. Everyone else is refused.
SLACK_APPROVER_USER_IDS=U0000000001
# Replay window for X-Slack-Request-Timestamp.
SLACK_MAX_TIMESTAMP_SKEW_SECONDS=300
# Lifetime of the opaque action token embedded in the Slack buttons.
SLACK_ACTION_TOKEN_TTL_SECONDS=604800
SLACK_API_BASE_URL=https://slack.com/api
# Fake-mode only: make chat.postMessage fail to exercise notification failure + retry.
SLACK_FAKE_FAIL_POSTS=false
# Public base URL used for "View evidence/dashboard" links in Slack and GitHub comments.
DASHBOARD_BASE_URL=http://localhost:8000

# --- Transactional outbox -----------------------------------------------------
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BASE_BACKOFF_SECONDS=2
OUTBOX_MAX_BACKOFF_SECONDS=300
OUTBOX_LEASE_SECONDS=120
LOG_LEVEL=INFO
# COOKIE_SECURE=true behind TLS
COOKIE_SECURE=false
